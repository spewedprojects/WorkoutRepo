<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer stroke -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="@color/strava_color"/>
            <padding android:top="4dp" android:right="4dp" android:bottom="4dp" android:left="4dp"/>
        </shape>
    </item>

    <!-- Inner fill with inset -->
    <item> <!--android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"-->
        <shape>
            <solid android:color="@color/strava_color_0.4"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>
