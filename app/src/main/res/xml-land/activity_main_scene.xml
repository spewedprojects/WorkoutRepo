<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetStart="@+id/start_hidden"
        motion:constraintSetEnd="@+id/end_visible"
        motion:duration="180"
        motion:motionInterpolator="easeInOut">

<!--        <OnSwipe-->
<!--            motion:dragDirection="dragRight"-->
<!--            motion:moveWhenScrollAtTop="false"-->
<!--            motion:nestedScrollFlags="supportScrollUp|disablePostScroll"-->
<!--            motion:touchAnchorId="@id/guide_container"-->
<!--            motion:touchAnchorSide="bottom" />-->
    </Transition>

    <ConstraintSet android:id="@+id/start_hidden">

        <Constraint android:id="@id/toolbar">
            <Layout
                android:layout_width="?attr/actionBarSize"
                android:layout_height="match_parent"
                motion:layout_constraintStart_toStartOf="parent"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintBottom_toBottomOf="parent"/>
        </Constraint>

        <Constraint android:id="@id/guide_container">
            <Layout
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:orientation="vertical"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toStartOf="@id/weekPager"
                motion:layout_constraintStart_toEndOf="@id/toolbar" />
            <PropertySet android:visibility="gone" />
        </Constraint>

        <Constraint android:id="@id/weekPager">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="10dp"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintEnd_toStartOf="@id/buttonBar"
                motion:layout_constraintStart_toEndOf="@id/toolbar"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintHorizontal_chainStyle="packed"
                motion:layout_constraintVertical_bias="0.5"/>
        </Constraint>

        <Constraint android:id="@id/buttonBar">
            <Layout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginVertical="4dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="14dp"
                motion:layout_constraintStart_toEndOf="@id/weekPager"
                motion:layout_constraintEnd_toEndOf="parent"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintVertical_bias="1"/>
            <PropertySet android:visibility="visible"/>
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end_visible">

        <Constraint android:id="@id/toolbar">
            <Layout
                android:layout_width="?attr/actionBarSize"
                android:layout_height="match_parent"
                motion:layout_constraintStart_toStartOf="parent"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintBottom_toBottomOf="parent"/>
        </Constraint>

        <Constraint android:id="@id/guide_container">
            <Layout
                android:layout_height="match_parent"
                android:layout_width="350dp"
                android:orientation="vertical"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintStart_toEndOf="@id/toolbar"/>
            <PropertySet android:visibility="visible"/>
        </Constraint>

        <Constraint android:id="@id/weekPager">
            <Layout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintEnd_toEndOf="parent"
                motion:layout_constraintStart_toEndOf="@id/guide_container"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintHorizontal_chainStyle="packed"
                motion:layout_constraintVertical_bias="0.5"/>
        </Constraint>

        <Constraint android:id="@id/buttonBar">
            <Layout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                motion:layout_constraintStart_toEndOf="@id/weekPager"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintBottom_toBottomOf="parent"/>
            <PropertySet android:visibility="gone"/>
        </Constraint>
    </ConstraintSet>

</MotionScene>
