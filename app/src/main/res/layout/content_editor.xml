<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <TextView
        android:id="@+id/editorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit"
        android:fontFamily="@font/atkinsonhyperlegiblenext_regular"
        android:textSize="20sp"
        android:textColor="@color/black_white"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="4dp"
        android:elevation="-1dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:cursorColor="?attr/colorAccent"
        app:boxStrokeColor="@color/textbox_stroke">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editorEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxHeight="400dp"
            android:hint="Add notes or workouts"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:fontFamily="@font/atkinsonhyperlegiblenext_medium"
            android:scrollbars="vertical"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvNewWorkoutGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A bullet point is automatically created for each new line"
        android:fontFamily="@font/atkinsonhyperlegiblenext_regular"
        android:textSize="16sp"
        android:padding="8dp"/>

    <HorizontalScrollView
        android:id="@+id/formatHelpContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal"
        android:scrollbarSize="2dp"
        android:requiresFadingEdge="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Format selection: "
                android:fontFamily="@font/atkinsonhyperlegiblenext_regular"
                android:textSize="16sp"
                android:layout_marginEnd="0dp"/>

            <ImageButton
                android:id="@+id/btnBold"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/format_bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bold selection"/>

            <ImageButton
                android:id="@+id/btnBulletList"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/format_list_bulleted"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bullet list"
                android:layout_marginStart="8dp"/>

            <ImageButton
                android:id="@+id/btnNumbList"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/format_list_numbered"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Numbered list"
                android:layout_marginStart="8dp"/>

            <ImageButton
                android:id="@+id/btnIndentIncrease"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/format_indent_increase"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Italicize selection"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/actionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:alpha="0.7"
            android:backgroundTint="@color/transparent"
            android:fontFamily="@font/atkinsonhyperlegiblenext_medium"
            android:text="Cancel"
            android:textColor="?attr/colorOnPrimary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/black_white"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/white_black"
            android:fontFamily="@font/atkinsonhyperlegiblenext_medium"
            android:text="Save"
            android:textColor="?attr/colorOnPrimary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/black_white"
            app:strokeWidth="1dp" />
    </LinearLayout>

</LinearLayout>